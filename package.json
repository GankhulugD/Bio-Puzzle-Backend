    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.x",
    "@types/pg": "^8.11.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.x",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.x",
    "@prisma/client": "^6.x",
