{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "dist", ".wrangler/tmp/dist"],
  "exclude": ["node_modules", "dist", "prisma.config.ts", "src/worker.ts"]
}
